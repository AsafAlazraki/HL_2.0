{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "jsx-a11y", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/routeTree.gen.ts",
    "tools/seed/legacy",
    "data",
    "public"
  ],
  "rules": {
    "no-console": "warn",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off",
    "jsx-a11y/no-autofocus": "off"
  },
  "overrides": [
    {
      "files": ["tools/**", "e2e/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
