{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "jsx-a11y", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/routeTree.gen.ts",
    "tools/seed/legacy",
    "data",
    "public",
    // A tool's own scratch space. A probe written to answer one question
    // is not code this repository ships, and it must not be able to fail
    // the gate for everybody else; `.gitignore` keeps it uncommitted and
    // `.prettierignore` leaves its formatting alone for the same reason.
    "**/.tmp",
    "**/.tmp-*"
  ],
  "rules": {
    "no-console": "warn",
    "react/jsx-key": "error",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": "off",
    "no-await-in-loop": "off",
    "jsx-a11y/no-autofocus": "off",
    "unicorn/no-thenable": "off"
  },
  // WHY THE RULES ABOVE AND BELOW ARE OFF.
  //
  // unicorn/no-thenable — a rule in this app has an `if` and a `then`, and `then` is the
  //   consequent of a business rule (src/domain/rules/configure, rules/engine), not a
  //   promise. The rule fires on the domain's own vocabulary and would otherwise be
  //   silenced file by file forever.
  // vitest/no-conditional-expect — ported suites come from HL_Playground verbatim and their
  //   assertions are never edited. Where one asserts inside a branch, that is the old
  //   test's shape and the port keeps it.
  // unicorn/prefer-set-has, consistent-function-scoping, no-array-sort — style opinions
  //   about ported engine bodies. A port changes imports, not bodies.
  "overrides": [
    {
      "files": ["tools/**", "e2e/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-console": "off",
        "vitest/no-conditional-expect": "off",
        // Each of the three below was measured against HL_Playground on 2026-09-17 and found
        // byte-identical there. A port changes imports, not bodies.
        //   vitest/valid-expect — vitest DOES take a second argument as the message, and the
        //     ported suites use it to name which category failed.
        //   typescript/no-non-null-asserted-optional-chain — the ported test asserts the
        //     pair fact it just put there exists; that is the assertion.
        //   unicorn/no-array-reverse — style, on a test body.
        "vitest/valid-expect": "off",
        "typescript/no-non-null-asserted-optional-chain": "off",
        "unicorn/no-array-reverse": "off"
      }
    },
    {
      // FOUR FILES, NOT EVERY TEST. `vitest/expect-expect` was off across the whole repo
      // to accommodate ported suites whose assertions the rule cannot see statically. Off
      // everywhere, a test that asserts nothing at all passes the linter in silence, which
      // is exactly the hollow test this port exists to prevent — so it is scoped to the
      // four files that need it, measured 2026-09-17, and every other suite is held to it.
      //   start.test.ts, commands.test.ts — the case asserts through a helper
      //     (`expectPreviewMatchesQuote`, `roundTrip`); the assertions are real, one level
      //     down, and both helpers came over verbatim.
      //   discover.test.ts, counts.test.ts — the case asserts inside a loop over the real
      //     pack ("for every candidate of this shape, the verdict is…"), which is the same
      //     ported shape `vitest/no-conditional-expect` is already off for.
      "files": [
        "src/domain/quote/start.test.ts",
        "src/domain/quote/commands.test.ts",
        "src/domain/rules/constraints/discover.test.ts",
        "src/domain/catalogue/table/counts.test.ts"
      ],
      "rules": {
        "vitest/expect-expect": "off"
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "unicorn/prefer-set-has": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-sort": "off",
        // The list below grows as ported modules land. Every one of them is a style
        // preference about a body that came over verbatim from HL_Playground, where it
        // passed that repo's own linter. Rewriting a ported body to please a linter is how
        // a settled behaviour quietly changes, so the rule goes off and the body stays.
        "unicorn/no-new-array": "off",
        "unicorn/prefer-array-find": "off",
        "unicorn/no-array-reverse": "off",
        "unicorn/prefer-string-raw": "off",
        "unicorn/no-useless-undefined": "off"
      }
    },
    {
      // TWO FILES, NOT THE WHOLE DOMAIN. `no-shadow` is correctness-adjacent rather than
      // style, so it stays on everywhere new code is written. Measured 2026-09-17: turned
      // on across `src/domain`, it fires exactly twice, both on bodies that came over
      // verbatim (`discover.ts` names a loop counter `n` inside a function that already has
      // one; `levels.test.ts` names a fixture `entity` inside a describe that already has
      // one). Renaming a ported local to satisfy a linter is an edit to logic nobody asked
      // for, so the two are named and the rule stays live for everything else.
      "files": ["src/domain/rules/constraints/discover.ts", "src/domain/pricing/levels.test.ts"],
      "rules": {
        "no-shadow": "off"
      }
    }
  ]
}
