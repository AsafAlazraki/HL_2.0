{
  "//": "THE 529 ASSAULT PRO, FROZEN BY THE OLD ENGINE — the diff src/domain/quote/golden.test.ts runs against. Every figure here was read out of the OLD repo (C:/Users/Asaf/dev/HL_Playground) by the OLD freeze.ts against the OLD committed seed, so it is evidence and not an expectation somebody typed. Ids are absent on purpose: they are minted per run there and are the seed key here, so a diff on them would measure the packer rather than the freeze.",
  "command": "npx esbuild <scratchpad>/golden/old.ts --bundle --platform=node --format=esm --target=node24 --alias:@=C:/Users/Asaf/dev/HL_Playground/src --loader:.css=empty --loader:.svg=empty --loader:.png=empty --define:import.meta.env={\"BASE_URL\":\"/\",\"MODE\":\"test\",\"DEV\":false,\"PROD\":true,\"SSR\":false} --outfile=<scratchpad>/golden/old.mjs && node <scratchpad>/golden/old.mjs",
  "script": [
    "/* One-off: freeze the Stacer 529 Assault Pro's quote lines from the",
    "   OLD seed through the OLD engine, and print them as JSON.",
    "   Run from the NEW repo; bundled by esbuild with @ aliased at the old",
    "   repo's src, so every import below is the old repo's own module. */",
    "import { buildNorthsideProject } from '@/demos/northside'",
    "import { useProjectStore } from '@/store/useProjectStore'",
    "import { createViewFor } from '@/features/views'",
    "import { mintQuoteFromView, candidateOffer } from '@/features/quote/freeze'",
    "import { rowLabel } from '@/types/model'",
    "import type { EntityDef, QuoteLine, RowData } from '@/types/model'",
    "",
    "const project = buildNorthsideProject()",
    "",
    "const entities: Record<string, EntityDef> = {}",
    "for (const e of project.entities) entities[e.id] = e",
    "const rowsByEntity: Record<string, RowData[]> = project.rowsByEntity",
    "",
    "useProjectStore.setState({ entities, rowsByEntity, loaded: true })",
    "",
    "const stacer = project.entities.find((e) => e.name === 'Stacer' && e.role !== 'join')",
    "if (!stacer) throw new Error('no Stacer table')",
    "const row = (rowsByEntity[stacer.id] ?? []).find(",
    "  (r) => rowLabel(stacer, r) === 'Stacer - 529 Assault Pro (Tournament)',",
    ")",
    "if (!row) throw new Error('no 529 Assault Pro row')",
    "",
    "const view = createViewFor(stacer.id)",
    "const quote = mintQuoteFromView({ viewId: view.id, rowId: row.id, reference: 'GOLDEN-0001' })",
    "if (!quote) throw new Error('mintQuoteFromView returned null')",
    "",
    "/* every value a document prints, and not one id: the ids are minted",
    "   per run in the old repo and are the seed key in the new pack, so a",
    "   diff on them would measure the packer rather than the freeze */",
    "const line = (l: QuoteLine) => ({",
    "  label: l.label,",
    "  qty: l.qty,",
    "  unitPrice: l.unitPrice,",
    "  priceColumnName: l.priceColumnName,",
    "  levelKey: l.levelKey,",
    "  levelResolved: l.levelResolved,",
    "  levels: l.levels.map((v) => ({",
    "    key: v.key,",
    "    label: v.label,",
    "    value: v.value,",
    "    scope: v.scope,",
    "    contains: v.contains ?? null,",
    "  })),",
    "  sourceNote: l.sourceNote ?? null,",
    "  pairFacts: l.pairFacts ?? null,",
    "  recommended: l.recommended ?? false,",
    "  image: l.image?.src ?? null,",
    "})",
    "",
    "const out = {",
    "  subjectLabel: quote.subjectLabel,",
    "  subjectSpecs: quote.subjectSpecs,",
    "  subjectImage: quote.subjectImage?.src ?? null,",
    "  levelKey: quote.levelKey,",
    "  note: quote.note ?? null,",
    "  sections: quote.sections.map((s) => ({",
    "    title: s.title,",
    "    tableName: entities[s.tableId]?.name ?? '',",
    "    pickedCount: s.pickedCount ?? null,",
    "    heldCount: s.heldCount ?? null,",
    "    lines: s.lineIds",
    "      .map((id) => quote.lines.find((l) => l.id === id))",
    "      .filter((l): l is QuoteLine => l !== undefined)",
    "      .map(line),",
    "  })),",
    "  offers: quote.sections.map((s) => {",
    "    const offer = candidateOffer(quote, s)",
    "    return {",
    "      title: s.title,",
    "      pool: offer.pool,",
    "      matched: offer.matched,",
    "      heldCount: offer.heldCount,",
    "      historic: offer.historic ?? null,",
    "      reason: offer.reason,",
    "      candidates: offer.candidates.map((c) => line(c.line)),",
    "    }",
    "  }),",
    "}",
    "",
    "process.stdout.write(JSON.stringify(out, null, 2))",
    ""
  ],
