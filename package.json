{
  "name": "hl-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "HelmLogic, rebuilt: a boat dealership's configurator and quoting system, local-first and backend-ready.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --max-warnings 0 src tools e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "unit": "vitest run",
    "check": "tsx tools/check.ts",
    "pack": "tsx tools/seed/pack.ts",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run unit && npm run check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@number-flow/react": "^0.6.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-table": "^9.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.4",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.0",
    "lucide-react": "*",
    "motion": "^13.3.0",
    "nanoid": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.38",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.0",
    "happy-dom": "^20.14.5",
    "oxlint": "1.83.0",
    "prettier": "^3.9.0",
    "sharp": "^0.35.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
