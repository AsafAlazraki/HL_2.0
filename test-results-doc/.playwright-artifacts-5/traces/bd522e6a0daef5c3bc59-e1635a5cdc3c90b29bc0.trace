{"type":"before","callId":"call@67","startTime":142142.702,"class":"Frame","method":"evaluateExpression","params":{"expression":"() => {\n      const bad = [];\n      for (const sheet of document.querySelectorAll('.doc-page')) {\n        const flow = sheet.querySelector('.doc-page__flow');\n        if (!flow) continue;\n        const room = flow.getBoundingClientRect();\n        let used = 0;\n        for (const atom of flow.children) used += atom.offsetHeight;\n        if (used > room.height + 1) {\n          bad.push(`${sheet.getAttribute('data-page')}: ${Math.round(used)} of ${Math.round(room.height)}`);\n        }\n      }\n      return bad;\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}},"stepId":"pw:api@68"}
